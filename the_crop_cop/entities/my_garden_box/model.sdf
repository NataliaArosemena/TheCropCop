<?xml version="1.0"?>
<sdf version="1.6">
  <model name="my_garden_box">
    <static>true</static>
    <link name="link">
      
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://my_garden_box/meshes/gazebo_plant.obj</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.215 0.15</size>
          </box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
